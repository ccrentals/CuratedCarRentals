{
  "expo": {
    "name": "Curated Car Rentals",
    "slug": "curated-car-rentals",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/app-icon-current.png",
    "scheme": "curatedcarrentals",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/app-icon-current.png"
    },
    "android": {
      "package": "com.curatedcarrentals.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#0A1323",
        "foregroundImage": "./assets/images/splash-current.png"
      },
      "predictiveBackGestureEnabled": true
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0A1323",
          "image": "./assets/images/splash-blank.png",
          "imageWidth": 1,
          "dark": {
            "backgroundColor": "#07111F",
            "image": "./assets/images/splash-blank.png"
          }
        }
      ],
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
