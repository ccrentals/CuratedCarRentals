{
  "name": "ccr-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "migrate": "node scripts/migrate.js",
    "seed:public-vehicles": "tsx scripts/seed-public-vehicles.ts",
    "e2e:seed": "mkdir -p .artifacts && tsx scripts/e2e-seed.ts",
    "e2e:clean": "tsx scripts/e2e-clean.ts",
    "e2e:reset": "tsx scripts/e2e-reset.ts",
    "e2e:list": "npx playwright test --config playwright.config.ts --list",
    "e2e:tour:desktop": "npm run e2e:seed && npx playwright test --project=desktop --grep @tour",
    "e2e:tour": "npm run e2e:tour:desktop",
    "e2e:watch": "npm run e2e:reset && npm run e2e:seed && E2E_BASE_URL=http://127.0.0.1:3000 npx playwright test --config playwright.config.ts --project=desktop --grep @tour",
    "e2e:observe": "npm run e2e:reset && npm run e2e:seed && E2E_BASE_URL=http://127.0.0.1:3000 npx playwright test --config playwright.config.ts --ui --project=desktop --grep @tour",
    "e2e:headed": "npm run e2e:reset && npm run e2e:seed && E2E_BASE_URL=http://127.0.0.1:3000 npx playwright test --config playwright.config.ts --headed --project=desktop --grep @tour --slow-mo 250",
    "e2e:ui": "npm run e2e:observe",
    "e2e:debug": "npm run e2e:seed && PWDEBUG=1 npx playwright test --project=desktop --grep @tour",
    "e2e:watch:headed": "npm run e2e:headed",
    "test": "tsx --test",
    "lint": "eslint",
    "clerk:sync-usernames": "tsx scripts/clerk_sync_usernames.ts",
    "cleanup:customer-addresses": "tsx scripts/normalize-customer-addresses.ts --apply",
    "check:vehicle-finance": "tsx scripts/check-no-vehicle-finance-refs.ts",
    "test:e2e": "playwright test",
    "pw:list": "mkdir -p .artifacts && npx playwright test --list > .artifacts/playwright-test-list.txt",
    "test:e2e:update": "playwright test --update-snapshots",
    "test:e2e:visual": "E2E_VISUAL=1 playwright test e2e/responsive-screenshots.spec.ts",
    "test:e2e:visual:update": "E2E_VISUAL=1 playwright test e2e/responsive-screenshots.spec.ts --update-snapshots",
    "check:dashboard-reports-parity": "tsx scripts/check-dashboard-reports-parity.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^6.38.2",
    "@prisma/client": "^7.3.0",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-popover": "^1.1.15",
    "bcryptjs": "^2.4.3",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "glightbox": "^3.3.1",
    "lucide-react": "^0.575.0",
    "next": "16.1.6",
    "pg": "^8.18.0",
    "prisma": "^6.19.2",
    "react": "19.2.3",
    "react-day-picker": "^9.14.0",
    "react-dom": "19.2.3",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
