# Secrets
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=
CSRF_SECRET=
CRON_SECRET=

# Clerk (Auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Optional migration toggle: set to 1 only after admin role migration to Clerk is complete.
CLERK_PROTECT_ADMIN_ROUTES=0
# Optional ops failover override for default admin auth entry (/admin/auth):
# - legacy => force /admin/login
# - clerk => force /sign-in
# - unset/blank => use DB-backed Admin Settings value
AUTH_LOGIN_METHOD_OVERRIDE=

# Cloudflare Turnstile (bot protection for public forms)
# In production these must be set; protected routes fail closed when missing.
# In local development you can use Turnstile test keys, or leave unset to use explicit local bypass.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Local-dev only bypass flags (never for production)
# Server verifier bypass: applies only when NODE_ENV != production and TURNSTILE_DEV_BYPASS=1
TURNSTILE_DEV_BYPASS=
# Client widget bypass: hides Turnstile widget and emits a local dev token when enabled.
NEXT_PUBLIC_TURNSTILE_DEV_BYPASS=

# Database (Neon)
# SSL recommendation:
# - Keep current secure behavior: add `sslmode=verify-full`
# - If you explicitly want libpq semantics now: add `uselibpqcompat=true&sslmode=require`
DATABASE_URL=
DIRECT_URL=

# Public URL of the site (required for links, redirects, and retained legacy callbacks)
SITE_URL=http://localhost:3000

# Stripe Checkout. Configure values per Netlify deploy context; never commit secrets.
# Staging branch: STRIPE_TEST_MODE=true and an sk_test_ key.
# Production: STRIPE_TEST_MODE=false and an sk_live_ key.
PAYMENT_PROVIDER=stripe
NEXT_PUBLIC_STRIPE_TEST_MODE= # true only for staging/test Checkout messaging
STRIPE_TEST_MODE= # true in staging; false in production
STRIPE_SECRET_KEY= # sk_test_ in staging; sk_live_ in production
STRIPE_WEBHOOK_SECRET= # whsec_ for that environment's Stripe webhook endpoint

# Legacy WiPay reconciliation only. Do not use these values to start new payments.
# Retain only while historical WiPay callbacks or admin replay remain supported.
WIPAY_API_KEY=
WIPAY_ENV=live

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# Invoices
# INVOICE_PDF_PROVIDER controls invoice generation only and defaults to pdfmonkey.
# Use gotenberg only if you intentionally want invoice fallback as the default path.
INVOICE_PDF_PROVIDER=pdfmonkey
# Required when invoices use gotenberg (Netlify should point this to your hosted Gotenberg URL)
GOTENBERG_URL=http://localhost:3001
# Required when invoices use pdfmonkey
PDFMONKEY_API_KEY=
PDFMONKEY_TEMPLATE_ID=
PDFMONKEY_QUOTE_TEMPLATE_ID=

# Uploads (Uploadcare)
NEXT_PUBLIC_UPLOADCARE_PUBLIC_KEY=
UPLOADCARE_SECRET_KEY=
# Optional project-specific CDN origin, for example https://project-subdomain.ucarecd.net
UPLOADCARE_CDN_BASE_URL=

# Uploads (Bunny Storage)
# Use environment-specific public and private Storage Zones. Set FILE_STORAGE_PROVIDER=bunny
# only after uploads and authenticated downloads have passed in that environment.
# Bunny access keys are server-only secrets; never add a NEXT_PUBLIC_ Bunny access key.
FILE_STORAGE_PROVIDER=uploadcare # uploadcare|bunny
# Use the region-specific Storage API endpoint shown on the zone's Bunny "FTP & API Access"
# page (for example, https://ny.storage.bunnycdn.com). Streaming request bodies cannot safely
# follow a redirect from the global endpoint.
BUNNY_STORAGE_ENDPOINT=
BUNNY_STORAGE_PUBLIC_ZONE=
BUNNY_STORAGE_PUBLIC_ACCESS_KEY=
# Public Pull Zone/custom CDN origin for vehicle, landing, and inspection images.
BUNNY_PUBLIC_CDN_URL=
# Private zone must not be connected to a public Pull Zone.
BUNNY_STORAGE_PRIVATE_ZONE=
BUNNY_STORAGE_PRIVATE_ACCESS_KEY=

# Direct browser-to-Bunny streaming gateway. The shared secret must be a long random value and
# must match UPLOAD_GATEWAY_SHARED_SECRET in the Bunny Edge Script. Neither value is public.
DIRECT_IMAGE_UPLOAD_GATEWAY_URL=
DIRECT_IMAGE_UPLOAD_GATEWAY_SHARED_SECRET=

# Bunny Edge Script secrets/settings (configure in Bunny, not Netlify):
# APP_ORIGIN=https://your-app.example.com
# UPLOAD_ALLOWED_ORIGINS=https://your-app.example.com
# UPLOAD_GATEWAY_SHARED_SECRET=<same value as DIRECT_IMAGE_UPLOAD_GATEWAY_SHARED_SECRET>
# BUNNY_STORAGE_ENDPOINT=https://ny.storage.bunnycdn.com
# BUNNY_STORAGE_PUBLIC_ZONE / BUNNY_STORAGE_PUBLIC_ACCESS_KEY
# BUNNY_STORAGE_PRIVATE_ZONE / BUNNY_STORAGE_PRIVATE_ACCESS_KEY

# Security headers / CSP
# Keep false by default so CSP enforces in production.
CSP_REPORT_ONLY=false
# Optional URI endpoint to receive browser CSP violation reports.
CSP_REPORT_URI=
