generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

enum BookingStatus {
  pending
  confirmed
  cancelled
}

enum PaymentStatus {
  initiated
  succeeded
  failed
  refunded
}

model Vehicle {
  id          String   @id @default(cuid())
  name        String
  make        String?
  model       String?
  year        Int?
  seatCount   Int?     @map("seat_count")
  dailyRate   Decimal  @db.Decimal(12,2)
  depositRate Decimal  @db.Decimal(12,2) // 0.30 = 30% deposit
  isActive    Boolean  @default(true)

  bookings    Booking[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Booking {
  id            String        @id @default(cuid())
  vehicleId     String
  vehicle       Vehicle       @relation(fields: [vehicleId], references: [id])

  // [startDate, endDate) allows back-to-back bookings
  startDate     DateTime
  endDate       DateTime

  customerName  String
  customerEmail String
  customerPhone String?

  totalAmount   Decimal       @db.Decimal(12,2)
  depositAmount Decimal       @db.Decimal(12,2)
  balanceDue    Decimal       @db.Decimal(12,2)

  status        BookingStatus @default(pending)

  payments      Payment[]

  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([vehicleId, startDate, endDate])
}

model Payment {
  id          String        @id @default(cuid())
  bookingId   String
  booking     Booking       @relation(fields: [bookingId], references: [id])

  amount      Decimal       @db.Decimal(12,2)
  currency    String        @default("JMD")
  status      PaymentStatus @default(initiated)

  provider    String?
  providerRef String?

  createdAt   DateTime      @default(now())
}
